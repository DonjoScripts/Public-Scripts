if not getgenv().FakeMastery then
	getgenv().FakeMastery = {
		Enable = true,
		ExplosionVFX = true
	}
end

if getgenv().FakeMastery.Enable ~= true then
	game.StarterGui:SetCore("SendNotification", {Title = "System", Text = "Script made by DonjoSx", Duration = 2})
	return
end
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local plrdata = ReplicatedStorage.PlayerData[LocalPlayer.Name]

local oldRemotemasteredglovelability = game:GetService("ReplicatedStorage"):FindFirstChild("GlovelMasteryAbility")
local namecallglovel

namecallglovel = hookmetamethod(game,"__namecall",function(self,...)
    local args = {...}
    local method = getnamecallmethod():lower()
    if not checkcaller() and self == oldRemotemasteredglovelability and method == "fireserver" and getgenv().FakeMastery.Enable == true and getgenv().FakeMastery.ExplosionVFX == true then
	    spawn(function()
			if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
				spawn(function() local bv = LocalPlayer.Character.HumanoidRootPart:WaitForChild("BodyVelocity") if bv then bv:Destroy() end end)
				ReplicatedStorage.RetroAbility:FireServer("Bomb")
	            local connection
	            connection = LocalPlayer.Character.Humanoid.Changed:Connect(function()
		            LocalPlayer.Character.Humanoid.AutoRotate = true
					connection:Disconnect()
				end)
	        end
	    end)
        return namecallglovel(self,...)
    end
    return namecallglovel(self,...)
end)

if getgenv().FakeMastery == true then
	if not plrdata.GloveMasteryProgress.Value:find("dig") or not plrdata.GloveMasteryProgress.Value:find("critstreak") or not plrdata.GloveMasteryProgress.Value:find("crits") then
		plrdata.GloveMasteryProgress.Value = '{"Glovel":{"Digs":9e9,"CritStreak":9e9,"Crits":9e9}}'
	end
    plrdata.GloveMasteryProgress.Value = plrdata.GloveMasteryProgress.Value:gsub("%d+", 999999)
    game:GetService("ReplicatedStorage").PlayerData.SillyBiffh.EnabledMasteredGloves.Value = '["Glovel"]'
end

plrdata.GloveMasteryProgress.Changed:Connect(function()
    if getgenv().FakeMastery == true then
    	if not plrdata.GloveMasteryProgress.Value:find("dig") or not plrdata.GloveMasteryProgress.Value:find("critstreak") or not plrdata.GloveMasteryProgress.Value:find("crits") then
			plrdata.GloveMasteryProgress.Value = '{"Glovel":{"Digs":9e9,"CritStreak":9e9,"Crits":9e9}}'
		end
        plrdata.GloveMasteryProgress.Value = plrdata.GloveMasteryProgress.Value:gsub("%d+", 999999)
        game:GetService("ReplicatedStorage").PlayerData.SillyBiffh.EnabledMasteredGloves.Value = '["Glovel"]'
    end
end)
